<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="CoreApplication (10003)" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <module name="platform-core" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.ailearn.platform.core.CoreApplication" />
    <!-- 本地联调必须显式加载 application-dev.yml，打开 Core 到 IoT 的只读 Facts。 -->
    <option name="ACTIVE_PROFILES" value="dev" />
    <!-- 本地 AI 配置只从被 Git 忽略的 windows.env 读取；文件不存在时保持默认关闭，不在运行配置中保存密钥。 -->
    <option name="PROGRAM_PARAMETERS" value="--spring.config.import=optional:file:$PROJECT_DIR$/deploy/openwebui/windows.env[.properties]" />
    <extension name="coverage">
      <pattern>
        <option name="PATTERN" value="com.ailearn.platform.core.*" />
        <option name="ENABLED" value="true" />
      </pattern>
    </extension>
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
