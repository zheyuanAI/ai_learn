# 本地非 AI 业务联调配置。复制为 runtime.env 后，把两个 HMAC 密钥设置为同一随机值。
# runtime.env 已被 Git 忽略，禁止提交真实密钥。
CORE_FACTS_IOT_ENABLED=true
CORE_FACTS_IOT_BASE_URL=http://127.0.0.1:10004
CORE_FACTS_IOT_HMAC_SECRET=<runtime-only-s7-secret>
IOT_INTERNAL_S7_HMAC_SECRET=<runtime-only-s7-secret>

# MQTT 尚未准备时保持关闭；不影响 IoT HTTP 台账及 Core 读取设备/告警事实。
IOT_MQTT_ENABLED=false
