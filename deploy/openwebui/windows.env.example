# 复制为同目录 windows.env；也可以直接运行 initialize-windows-config.ps1 自动生成内部密钥。
# 只有 SILICONFLOW_API_KEY 和首次初始化后生成的 WMS_OPENWEBUI_API_KEY 需要人工补充。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_KEY=

# Open WebUI 自身签名密钥。自动初始化脚本会生成，不得提交。
OPENWEBUI_SECRET_KEY=

# 首次登录 Open WebUI 后，由管理员在账号设置中创建。
WMS_OPENWEBUI_API_KEY=

# Open WebUI 调用 WMS 查询工具的独立服务密钥。自动初始化脚本会生成，不得提交。
WMS_AI_TOOL_SERVICE_SECRET=

# Core 调用 IoT 只读 Facts 的配对 HMAC。初始化脚本会为两端生成同一个随机值，不得提交。
CORE_FACTS_IOT_ENABLED=true
CORE_FACTS_IOT_HMAC_SECRET=
IOT_INTERNAL_S7_HMAC_SECRET=

WMS_AI_PROVIDER=open-webui
WMS_AI_ENABLED=true
# AI 业务接口唯一白名单；Gateway 读取后生成 Open WebUI 工具目录并执行运行时拦截。
WMS_AI_API_WHITELIST_PATH=../deploy/openwebui/wms-ai-api-whitelist.yml
WMS_OPENWEBUI_BASE_URL=http://127.0.0.1:3000
WMS_OPENWEBUI_MODEL=wms-assistant
WMS_OPENWEBUI_TOOL_SERVER_ID=server:wms
WMS_OPENWEBUI_TOOL_SERVER_IDS=server:wms_core,server:wms_iot
WMS_AI_TOOL_TIMEOUT=10s
