{
  "name": "ai-learn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:watch": "vitest",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/menu-regression.ps1",
    "test:e2e:golden": "playwright test e2e/golden-facts.spec.ts",
    "test:e2e:list": "playwright test e2e/golden-facts.spec.ts --list"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.14.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.19",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.1.2",
    "sass-embedded": "^1.85.0",
    "typescript": "^5.5.4",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-element-plus": "^0.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.29"
  }
}
